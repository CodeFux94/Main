# Kopiere diese Datei lokal nach .env.local und trage die Werte ein.
# In Vercel: Project → Settings → Environment Variables (für Production UND Preview).
# NIEMALS echte Werte committen!

# Supabase → Project Settings → Data API: Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys: "Publishable key" (sb_publishable_…)
#   (alternativ der Legacy "anon" Key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Supabase → Project Settings → API Keys: "Secret key" (sb_secret_…) – GEHEIM!
#   (alternativ der Legacy "service_role" Key)
SUPABASE_SECRET_KEY=sb_secret_xxx

# Die einzige E-Mail-Adresse, die sich anmelden darf
ALLOWED_EMAIL=du@example.com

# --- ab Etappe 2 (Strava) ---
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_WEBHOOK_VERIFY_TOKEN=
# CRON_SECRET=
